{
  "name": "sciphys-os",
  "version": "0.2.0",
  "description": "Open agent runtime, skills, evidence standards, and instrument analysis primitives for experimental science.",
  "packageManager": "pnpm@9.15.9",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "sciphys": "dist/scripts/sciphys.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "registry",
    "skills",
    "specs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "regression:xrd": "pnpm build && node dist/scripts/xrd-benchmark.js",
    "regression:evidence": "pnpm build && node dist/scripts/evidence-regression.js",
    "benchmark:xrd": "pnpm regression:xrd",
    "validate:repo": "python scripts/validate-repository.py",
    "test": "pnpm build && node dist/scripts/xrd-benchmark.js && node dist/scripts/evidence-regression.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sciphys-ai/sciphys-os.git"
  },
  "bugs": {
    "url": "https://github.com/sciphys-ai/sciphys-os/issues"
  },
  "homepage": "https://github.com/sciphys-ai/sciphys-os#readme",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
